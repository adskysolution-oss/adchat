generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 1. AUTHENTICATION & USER MODULE
// ---------------------------------------------------------

enum AccountType {
  PERSONAL
  BUSINESS
}

enum OnlineStatus {
  ONLINE
  OFFLINE
  AWAY
}

model User {
  id             String    @id @default(uuid())
  phoneNumber    String    @unique
  accountType    AccountType @default(PERSONAL)
  
  // Profile Info
  firstName      String?
  lastName       String?
  about          String?   @default("Available")
  profileImage   String?
  
  // Auth & Security
  pinHash        String?   // For 2-step verification
  isVerified     Boolean   @default(false)
  
  // Status
  onlineStatus   OnlineStatus @default(OFFLINE)
  lastSeen       DateTime?
  
  // Settings (Power User & Privacy)
  privacySettings Json?    
  powerSettings   Json?    
  themeSettings   Json?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  devices        Device[]
  chats          ChatParticipant[]
  messages       Message[]
  businessProfile BusinessProfile?
  contacts       Contact[] @relation("UserContacts")
  contactsOf     Contact[] @relation("ContactedBy")
  statusUpdates  StatusUpdate[]
  calls          CallParticipant[]
  blocks         Block[]   @relation("Blocker")
  blockedBy      Block[]   @relation("BlockedUser")
  
  // New features
  starredMessages StarredMessage[]
  messageEdits    MessageEdit[]
  reactions       Reaction[]
  
  // Business Specific Relations
  assignedLeads     Lead[]    @relation("AssignedAgent")
  assignedChats     BusinessChatAssignment[]
  internalNotes     InternalNote[]

  // Step 4 Relations
  statusReactions   StatusReaction[]
  statusReplies     StatusReply[]
  statusViews       StatusView[]
  channelMemberships ChannelMember[]
  communityMemberships CommunityMember[]
  ownedChannels     Channel[] @relation("ChannelOwner")
  ownedCommunities  Community[] @relation("CommunityOwner")
  broadcastLists    BroadcastList[]
  channelReports    ChannelReport[]

  // Step 5 Relations
  businessAgents    BusinessAgent[]
  customerRatings   CustomerRating[] @relation("CustomerRating")
  givenRatings      CustomerRating[] @relation("AgentRating")

  personalAutoReplies PersonalAutoReply[]
  scheduledPersonalMessages ScheduledMessage[]

  tier              String    @default("FREE")
  
  // Step 6: Calling Relations
  callsStarted      Call[]    @relation("Caller")
  callParticipations CallParticipant[]
  callSettings      CallSettings?
  callNotes         CallNote[]
}

model Device {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deviceType     String    
  deviceId       String    @unique 
  pushToken      String?
  publicKey      String?   
  lastActive     DateTime  @default(now())
  isActive       Boolean   @default(true)
  
  createdAt      DateTime  @default(now())
}

model Contact {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  
  contactId      String
  contactUser    User      @relation("ContactedBy", fields: [contactId], references: [id], onDelete: Cascade)
  
  savedName      String?
  isMuted        Boolean   @default(false)
  isBlocked      Boolean   @default(false)
  
  createdAt      DateTime  @default(now())

  @@unique([userId, contactId])
}

model Block {
  id             String    @id @default(uuid())
  blockerId      String
  blocker        User      @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId      String
  blockedUser    User      @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([blockerId, blockedId])
}


// ---------------------------------------------------------
// 2. CHAT & MESSAGING MODULE
// ---------------------------------------------------------

enum ChatType {
  ONE_TO_ONE
  GROUP
  COMMUNITY
  CHANNEL
  SECRET
}

model Chat {
  id             String    @id @default(uuid())
  type           ChatType
  
  // Group/Channel Info
  name           String?
  description    String?
  avatarUrl      String?
  inviteLink     String?   @unique
  adminOnlyMode  Boolean   @default(false)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  participants   ChatParticipant[]
  messages       Message[]
  
  communityId    String?
  community      Community? @relation(fields: [communityId], references: [id])

  assignments    BusinessChatAssignment[]
  internalNotes  InternalNote[]
  pinnedMessages PinnedMessage[]
}

enum ParticipantRole {
  ADMIN
  MODERATOR
  MEMBER
  GUEST
}

model ChatParticipant {
  id             String    @id @default(uuid())
  chatId         String
  chat           Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime  @default(now())
  
  unreadCount    Int       @default(0)
  isMuted        Boolean   @default(false)
  isArchived     Boolean   @default(false)
  isPinned       Boolean   @default(false)
  
  customWallpaper String?
  customNotification String?

  @@unique([chatId, userId])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  SYSTEM
  LINK
  PRODUCT
  OFFER
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id             String    @id @default(uuid())
  chatId         String
  chat           Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  type           MessageType @default(TEXT)
  content        String?   
  mediaUrl       String?
  mediaSize      Int?
  mediaMimeType  String?
  mediaThumbnail String?   // For preview
  
  status         MessageStatus @default(SENT)
  
  replyToId      String?
  replyTo        Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[] @relation("MessageReplies")
  
  isForwarded    Boolean   @default(false)
  isDeleted      Boolean   @default(false) // Soft delete (everyone)
  deletedFor     String[]  // Array of User IDs who deleted for themselves
  
  isEdited       Boolean   @default(false)
  
  scheduledFor   DateTime? // For Message Scheduler
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reactions      Reaction[]
  edits          MessageEdit[]
  starrers       StarredMessage[]
  pinnedIn       PinnedMessage[]
}

model MessageEdit {
  id             String    @id @default(uuid())
  messageId      String
  message        Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editorId       String
  editor         User      @relation(fields: [editorId], references: [id], onDelete: Cascade)
  
  oldContent     String?
  newContent     String?
  
  editedAt       DateTime  @default(now())
}

model Reaction {
  id             String    @id @default(uuid())
  messageId      String
  message        Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String    
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji          String
  createdAt      DateTime  @default(now())

  @@unique([messageId, userId])
}

model StarredMessage {
  id             String    @id @default(uuid())
  messageId      String
  message        Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([messageId, userId])
}

model PinnedMessage {
  id             String    @id @default(uuid())
  chatId         String
  chat           Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId      String
  message        Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedById     String
  createdAt      DateTime  @default(now())

  @@unique([chatId, messageId])
}


// ---------------------------------------------------------
// 3. CALLS MODULE (Step 6)
// ---------------------------------------------------------

enum CallType {
  VOICE
  VIDEO
  GROUP_VOICE
  GROUP_VIDEO
}

enum CallStatus {
  INITIATED
  RINGING
  CONNECTING
  CONNECTED
  ENDED
  MISSED
  REJECTED
  CANCELLED
  FAILED
  TIMEOUT
}

model Call {
  id             String    @id @default(uuid())
  type           CallType
  status         CallStatus @default(INITIATED)
  
  callerId       String
  caller         User      @relation("Caller", fields: [callerId], references: [id])
  
  chatId         String?   // If started from a chat
  chat           Chat?     @relation(fields: [chatId], references: [id])
  
  businessId     String?   // For business calls
  
  startTime      DateTime?
  endTime        DateTime?
  duration       Int?      // In seconds
  
  offer          Json?     // WebRTC Offer
  answer         Json?     // WebRTC Answer
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  participants   CallParticipant[]
  events         CallEvent[]
  notes          CallNote[]
  businessLog    BusinessCallLog?
}

model CallParticipant {
  id             String    @id @default(uuid())
  callId         String
  call           Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role           String    @default("PARTICIPANT") // HOST, PARTICIPANT
  status         CallStatus @default(INITIATED)
  
  joinedAt       DateTime?
  leftAt         DateTime?
  
  isMuted        Boolean   @default(false)
  isVideoOn      Boolean   @default(true)
  
  createdAt      DateTime  @default(now())

  @@unique([callId, userId])
}

model CallEvent {
  id             String    @id @default(uuid())
  callId         String
  call           Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  
  type           String    // offer, answer, ice-candidate, mute, video-toggle, etc.
  payload        Json?
  userId         String?
  
  createdAt      DateTime  @default(now())
}

model CallNote {
  id             String    @id @default(uuid())
  callId         String
  call           Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  agentId        String
  agent          User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  content        String
  outcome        String?   // Interested, Follow-up, Converted, Not Interested
  
  createdAt      DateTime  @default(now())
}

model CallSettings {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  hideStatus     Boolean   @default(false)
  blockUnknown   Boolean   @default(false)
  customRingtones Json?    // { contactId: ringtoneUrl }
  autoReject     String[]  // List of contact IDs
  lowDataMode    Boolean   @default(false)
  
  createdAt      DateTime  @default(now())
}

model BusinessCallLog {
  id             String    @id @default(uuid())
  callId         String    @unique
  call           Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  
  businessId     String
  leadId         String?
  agentId        String?
  
  assignedAt     DateTime?
  isLeadCreated  Boolean   @default(false)
  performanceScore Int?    
  
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------
// 4. STATUS / STORIES MODULE
// ---------------------------------------------------------

enum StatusPrivacyType {
  EVERYONE
  CONTACTS
  SELECTED_CONTACTS
  EXCLUDED_CONTACTS
}

model StatusUpdate {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            MessageType
  mediaUrl        String?
  caption         String?
  backgroundColor String?  
  linkUrl         String?   // For Link status
  productId       String?   // For Product promotion status
  offerDetails    String?   // For Offer status
  
  privacyType     StatusPrivacyType @default(EVERYONE)
  privacyUsers    String[]  // IDs of users for SELECTED/EXCLUDED
  
  expiresAt       DateTime
  scheduledAt     DateTime? // For scheduled status
  isArchived      Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  
  views           StatusView[]
  reactions       StatusReaction[]
  replies         StatusReply[]
}

model StatusView {
  id             String    @id @default(uuid())
  statusId       String
  status         StatusUpdate @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewerId       String
  viewer         User      @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt       DateTime  @default(now())
  isSecretView   Boolean   @default(false)

  @@unique([statusId, viewerId])
}

model StatusReaction {
  id             String    @id @default(uuid())
  statusId       String
  status         StatusUpdate @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji          String
  createdAt      DateTime  @default(now())

  @@unique([statusId, userId])
}

model StatusReply {
  id             String    @id @default(uuid())
  statusId       String
  status         StatusUpdate @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message        String
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------
// 5. CHANNELS MODULE
// ---------------------------------------------------------

model Channel {
  id             String    @id @default(uuid())
  name           String
  description    String?
  iconUrl        String?
  isPublic       Boolean   @default(true)
  isVerified     Boolean   @default(false)
  category       String?
  
  ownerId        String
  owner          User      @relation("ChannelOwner", fields: [ownerId], references: [id])
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members        ChannelMember[]
  posts          ChannelPost[]
  reports        ChannelReport[]
}

model ChannelMember {
  id             String    @id @default(uuid())
  channelId      String
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime  @default(now())

  @@unique([channelId, userId])
}

model ChannelPost {
  id             String    @id @default(uuid())
  channelId      String
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  type           MessageType
  content        String?
  mediaUrl       String?
  mediaSize      Int?
  mediaMimeType  String?
  
  viewCount      Int       @default(0)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reactions      ChannelPostReaction[]
  replies        ChannelPostReply[]
}

model ChannelPostReaction {
  id             String    @id @default(uuid())
  postId         String
  post           ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId         String
  emoji          String
  createdAt      DateTime  @default(now())

  @@unique([postId, userId])
}

model ChannelPostReply {
  id             String    @id @default(uuid())
  postId         String
  post           ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId         String
  message        String
  createdAt      DateTime  @default(now())
}

model ChannelReport {
  id             String    @id @default(uuid())
  channelId      String
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason         String
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------
// 4. CAMPAIGNS & MARKETING MODULE (Step 7)
// ---------------------------------------------------------

enum CampaignType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  PRODUCT
  OFFER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

model Campaign {
  id             String    @id @default(uuid())
  businessId     String
  name           String
  type           CampaignType
  status         CampaignStatus @default(DRAFT)
  
  content        String?   // For simple text campaigns
  mediaUrl       String?
  templateId     String?
  template       MessageTemplate? @relation(fields: [templateId], references: [id])
  
  audienceType   String    // LABELS, LEADS, CONTACTS, SEGMENT
  audienceFilter Json?     // { labelIds: [], leadStatus: [] }
  
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  
  totalRecipients Int      @default(0)
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  readCount      Int       @default(0)
  repliedCount   Int       @default(0)
  failedCount    Int       @default(0)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages       CampaignMessage[]
  reports        CampaignReport[]
}

model MessageTemplate {
  id             String    @id @default(uuid())
  businessId     String
  name           String
  category       String    // MARKETING, UTILITY, AUTHENTICATION, SERVICE
  language       String    @default("en")
  
  headerType     String?   // TEXT, IMAGE, VIDEO, DOCUMENT
  headerContent  String?
  bodyText       String
  footerText     String?
  
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  buttons        TemplateButton[]
  campaigns      Campaign[]
}

model TemplateButton {
  id             String    @id @default(uuid())
  templateId     String
  template       MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  type           String    // QUICK_REPLY, CALL, URL
  text           String
  value          String    // Phone number or URL
  
  index          Int
}

model CampaignMessage {
  id             String    @id @default(uuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  recipientId    String
  status         String    @default("PENDING") // SENT, DELIVERED, READ, FAILED
  error          String?
  
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  
  createdAt      DateTime  @default(now())
}

model CampaignReport {
  id             String    @id @default(uuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  metric         String    // DELIVERY_RATE, READ_RATE, etc.
  value          Float
  
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------
// 5. AUDIENCE & CONSENT (Step 7)
// ---------------------------------------------------------

model Contact {
  id             String    @id @default(uuid())
  businessId     String
  phoneNumber    String
  firstName      String?
  lastName       String?
  email          String?
  
  labels         String[]
  consentStatus  String    @default("NONE") // OPTED_IN, OPTED_OUT, NONE
  consentSource  String?
  consentDate    DateTime?
  
  riskScore      Int       @default(0)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([businessId, phoneNumber])
}

model AudienceSegment {
  id             String    @id @default(uuid())
  businessId     String
  name           String
  filter         Json      // { labels: [], location: "", lastInteraction: "" }
  
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------
// 6. AUTOMATION & CHATBOT (Step 7)
// ---------------------------------------------------------

model AutomationRule {
  id             String    @id @default(uuid())
  businessId     String
  name           String
  trigger        String    // KEYWORD, GREETING, AWAY, MISSED_CALL, NEW_LEAD
  condition      Json?     // { keywords: [], hours: "" }
  action         Json      // { message: "", assignAgent: "", updateStatus: "" }
  
  isActive       Boolean   @default(true)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ChatbotFlow {
  id             String    @id @default(uuid())
  businessId     String
  name           String
  description    String?
  
  startTrigger   String?   // KEYWORD or ENTRY_POINT
  isActive       Boolean   @default(false)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  nodes          ChatbotNode[]
  edges          ChatbotEdge[]
  sessions       ChatbotSession[]
}

model ChatbotNode {
  id             String    @id @default(uuid())
  flowId         String
  flow           ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  
  type           String    // MESSAGE, QUESTION, BUTTONS, CONDITION, HANDOVER
  data           Json      // { text: "", options: [], condition: "" }
  
  positionX      Float     @default(0)
  positionY      Float     @default(0)
}

model ChatbotEdge {
  id             String    @id @default(uuid())
  flowId         String
  flow           ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  
  sourceId       String
  targetId       String
  label          String?
}

model ChatbotSession {
  id             String    @id @default(uuid())
  flowId         String
  flow           ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  
  userId         String
  chatId         String
  
  currentNodeId  String?
  context        Json?     // Stored user answers
  
  status         String    @default("ACTIVE") // ACTIVE, COMPLETED, HANDED_OVER
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  body      String
  type      String   // MESSAGE, CALL, CAMPAIGN, SYSTEM
  metadata  Json?
  
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PersonalAutoReply {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  trigger        String    // ALL, CONTACTS_ONLY, KEYWORD
  keyword        String?
  message        String
  
  startTime      String?   // "HH:mm"
  endTime        String?   // "HH:mm"
  
  isActive       Boolean   @default(true)
  
  createdAt      DateTime  @default(now())
}

model ScheduledMessage {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  chatId         String
  content        String
  scheduledAt    DateTime
  
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------
// 6. COMMUNITIES MODULE
// ---------------------------------------------------------

model Community {
  id             String    @id @default(uuid())
  name           String
  description    String?
  avatarUrl      String?
  isPublic       Boolean   @default(true)
  rules          String?
  
  ownerId        String
  owner          User      @relation("CommunityOwner", fields: [ownerId], references: [id])
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members        CommunityMember[]
  groups         Chat[]    
  invites        CommunityInvite[]
}

model CommunityMember {
  id             String    @id @default(uuid())
  communityId    String
  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER)
  isApproved     Boolean   @default(false)
  joinedAt       DateTime  @default(now())

  @@unique([communityId, userId])
}

model CommunityInvite {
  id             String    @id @default(uuid())
  communityId    String
  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  inviteCode     String    @unique
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------
// 7. BROADCAST MODULE
// ---------------------------------------------------------

model BroadcastList {
  id             String    @id @default(uuid())
  name           String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recipients     BroadcastRecipient[]
  messages       BroadcastMessage[]
}

model BroadcastRecipient {
  id              String    @id @default(uuid())
  broadcastListId String
  broadcastList   BroadcastList @relation(fields: [broadcastListId], references: [id], onDelete: Cascade)
  userId          String
  hasConsent      Boolean   @default(true)
  joinedAt        DateTime  @default(now())

  @@unique([broadcastListId, userId])
}

model BroadcastMessage {
  id              String    @id @default(uuid())
  broadcastListId String
  broadcastList   BroadcastList @relation(fields: [broadcastListId], references: [id], onDelete: Cascade)
  
  type            MessageType
  content         String?
  mediaUrl        String?
  
  scheduledAt     DateTime?
  
  createdAt       DateTime  @default(now())

  reports         BroadcastReport[]
}

model BroadcastReport {
  id                 String    @id @default(uuid())
  broadcastMessageId String
  broadcastMessage   BroadcastMessage @relation(fields: [broadcastMessageId], references: [id], onDelete: Cascade)
  recipientId        String
  
  status             MessageStatus @default(SENT)
  deliveredAt        DateTime?
  readAt             DateTime?
  repliedAt          DateTime?
  
  createdAt          DateTime  @default(now())
}

// ---------------------------------------------------------
// 8. BUSINESS MODULE & CRM (Step 5)
// ---------------------------------------------------------

model BusinessProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessName   String
  category       String?
  email          String?
  website        String?
  address        String?
  mapLocation    Json?     // Map coordinates
  workingHours   Json?
  
  gstNumber      String?
  isVerified     Boolean   @default(false)
  qrCodeUrl      String?
  shortLink      String?
  
  greetingMessage String?
  awayMessage    String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branches       BusinessBranch[]
  products       Product[]
  productCollections ProductCollection[]
  labels         Label[]
  quickReplies   QuickReply[]
  faqReplies     FaqReply[]
  leads          Lead[]
  campaigns      Campaign[]
  agents         BusinessAgent[]
}

model BusinessBranch {
  id             String    @id @default(uuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  address        String
  mapLocation    Json?
  phoneNumber    String?
  createdAt      DateTime  @default(now())
}

model BusinessAgent {
  id             String    @id @default(uuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role           String    @default("AGENT") // OWNER, ADMIN, MANAGER, AGENT
  targetDaily    Int       @default(0)
  
  createdAt      DateTime  @default(now())
  
  @@unique([businessId, userId])
}

model Product {
  id             String    @id @default(uuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  name           String
  description    String?
  price          Float?
  offerPrice     Float?
  currency       String    @default("USD")
  
  sku            String?
  stockStatus    String    @default("IN_STOCK") // IN_STOCK, OUT_OF_STOCK
  
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  
  collectionId   String?
  collection     ProductCollection? @relation(fields: [collectionId], references: [id])

  isHidden       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  media          ProductMedia[]
  inquiries      ProductInquiry[]
}

model ProductMedia {
  id             String    @id @default(uuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           MessageType // IMAGE, VIDEO
  url            String
  createdAt      DateTime  @default(now())
}

model ProductCategory {
  id             String    @id @default(uuid())
  name           String
  products       Product[]
}

model ProductCollection {
  id             String    @id @default(uuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  products       Product[]
}

model ProductInquiry {
  id             String    @id @default(uuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId         String
  chatId         String
  message        String?
  createdAt      DateTime  @default(now())
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  QUALIFIED
  CONVERTED
  LOST
  REJECTED
}

model Lead {
  id             String    @id @default(uuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  name           String
  phoneNumber    String?
  email          String?
  company        String?
  requirement    String?
  value          Float?
  source         String?   @default("CHAT")
  
  status         LeadStatus @default(NEW)
  
  assignedToId   String?
  assignedTo     User?     @relation("AssignedAgent", fields: [assignedToId], references: [id])
  
  followUpDate   DateTime?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  labels         Label[]   @relation("LeadLabels")
  notes          LeadNote[]
  timeline       LeadTimeline[]
  reminders      FollowUpReminder[]
}

model LeadNote {
  id             String    @id @default(uuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId        String
  content        String
  createdAt      DateTime  @default(now())
}

model LeadTimeline {
  id             String    @id @default(uuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action         String
  details        String?
  agentId        String?
  createdAt      DateTime  @default(now())
}

model Label {
  id             String    @id @default(uuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  color          String    
  leads          Lead[]    @relation("LeadLabels")
}

model QuickReply {
  id             String    @id @default(uuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shortcut       String    
  message        String
  mediaUrl       String?
}

model FaqReply {
  id             String    @id @default(uuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  question       String
  answer         String
}

model FollowUpReminder {
  id             String    @id @default(uuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  remindAt       DateTime
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

model CustomerRating {
  id             String    @id @default(uuid())
  chatId         String
  customerId     String
  customer       User      @relation("CustomerRating", fields: [customerId], references: [id])
  agentId        String
  agent          User      @relation("AgentRating", fields: [agentId], references: [id])
  rating         Int       @default(5)
  comment        String?
  createdAt      DateTime  @default(now())
}

model BusinessChatAssignment {
  id             String    @id @default(uuid())
  chatId         String
  chat           Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  agentId        String
  agent          User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignedAt     DateTime  @default(now())
  status         String    @default("ACTIVE") // ACTIVE, TRANSFERRED, RESOLVED
}

model InternalNote {
  id             String    @id @default(uuid())
  chatId         String
  chat           Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  agentId        String
  agent          User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime  @default(now())
}

model Campaign {
  id             String    @id @default(uuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  messageContent String
  mediaUrl       String?
  status         String    
  scheduledFor   DateTime?
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  readCount      Int       @default(0)
  repliedCount   Int       @default(0)
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------
// 9. POWER USER MODULE (Auto Replies)
// ---------------------------------------------------------

model AutoReplyRule {
  id             String    @id @default(uuid())
  userId         String    
  name           String
  message        String
  isActive       Boolean   @default(true)
  targetAudience String    // ALL, CONTACTS, NON_CONTACTS
  exceptGroups   Boolean   @default(true)
  scheduleTime   String?   
  createdAt      DateTime  @default(now())
}
